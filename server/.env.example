# Copy this file to .env and fill it in. .env holds passwords, so it is
# never committed to git. On Render, set the same names under Environment.

# Supabase > Project Settings > Database > Connection string > "Session pooler"
# (the pooler works over IPv4, which Render needs). Put your database
# password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Any long random string. The ESP32 sends it in the X-API-Key header.
# Make one with:  node -e "console.log(crypto.randomUUID())"
API_KEY=change-me
